<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RssApp.Native.Windows.Views.Dialogs.FeedSubscription.FeedSubscriptionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RssApp.Native.Windows.Views.Dialogs.FeedSubscription"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    x:Uid="/FeedSubscriptionEditDialog/Root"
    PrimaryButtonCommand="{x:Bind ViewModel.SaveCommand}">

    <Grid RowDefinitions="auto,auto">
        <TextBox Grid.Row="0" x:Uid="/FeedSubscriptionEditDialog/NameField" Text="{x:Bind ViewModel.FeedName, Mode=TwoWay}"  />
        <TextBox Grid.Row="1" x:Uid="/FeedSubscriptionEditDialog/UriField" Text="{x:Bind ViewModel.FeedUri, Mode=TwoWay}" />
    </Grid>
</ContentDialog>
