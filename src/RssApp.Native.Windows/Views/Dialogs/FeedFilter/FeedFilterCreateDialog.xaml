<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RssApp.Native.Windows.Views.Dialogs.FeedFilter.FeedFilterCreateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RssApp.Native.Windows.Views.Dialogs.FeedFilter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:feedSubscription="using:RssApp.Application.Models.FeedSubscription"
    mc:Ignorable="d"

    x:Uid="/FeedFilterCreateDialog/Root"
    PrimaryButtonCommand="{x:Bind ViewModel.SaveCommand}">

    <StackPanel>
        <TextBox x:Uid="/FeedFilterCreateDialog/ExpressionHeader" Text="{x:Bind ViewModel.FilterRegex, Mode=TwoWay}" />
        <CheckBox x:Uid="/FeedFilterCreateDialog/IsWhitelistCheckbox" IsChecked="{x:Bind ViewModel.IsWhitelist, Mode=TwoWay}" />

        <TextBlock x:Uid="/FeedFilterCreateDialog/AppliesToHeader" />
        <CheckBox x:Uid="/FeedFilterCreateDialog/AppliesToTitleCheckbox" IsChecked="{x:Bind ViewModel.AppliesToTitle, Mode=TwoWay}" />
        <CheckBox x:Uid="/FeedFilterCreateDialog/AppliesToBodyCheckbox" IsChecked="{x:Bind ViewModel.AppliesToBody, Mode=TwoWay}" />
        <CheckBox x:Uid="/FeedFilterCreateDialog/AppliesToUriCheckbox" IsChecked="{x:Bind ViewModel.AppliesToUri, Mode=TwoWay}" />

        <ListView ItemsSource="{x:Bind ViewModel.AvailableFeedSubscriptions}" SelectionChanged="Selector_OnSelectionChanged" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="feedSubscription:FeedSubscriptionModel">
                    <TextBlock Text="{x:Bind FeedName}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
