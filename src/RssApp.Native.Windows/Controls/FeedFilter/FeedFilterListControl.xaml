<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RssApp.Native.Windows.Controls.FeedFilter.FeedFilterListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RssApp.Native.Windows.Controls.FeedFilter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:feedFilter="using:RssApp.Application.Models.FeedFilter"
    mc:Ignorable="d">

    <ListView ItemsSource="{x:Bind ViewModel.FeedFilters}" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="feedFilter:FeedFilterModel">
                <Grid ColumnDefinitions="*,auto,auto">
                    <TextBlock Grid.Column="0" Text="{x:Bind FilterRegex}" />

                    <Button Grid.Column="2" Command="{x:Bind RequestDeleteCommand}">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
