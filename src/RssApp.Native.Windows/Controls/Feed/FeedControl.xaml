<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RssApp.Native.Windows.Controls.Feed.FeedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RssApp.Native.Windows.Controls.Feed"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:feedReader="using:CodeHollow.FeedReader"
    mc:Ignorable="d">

    <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="feedReader:FeedItem">
                <Grid RowDefinitions="auto,auto,auto,auto" Margin="0,20,0,0">
                    <HyperlinkButton Grid.Row="0" FontSize="20" NavigateUri="{x:Bind Link}" Content="{x:Bind Title}" />
                    <TextBlock Grid.Row="1">
                            <Run Text="By"/>
                            <Run Text="{x:Bind Author, TargetNullValue='Unknown', FallbackValue='Unknown'}" />
                            <Run Text="{x:Bind PublishingDate, Converter={StaticResource RelativeDateTimeConverter}}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2">
                            <Run Text="Tags:" />
                            <Run Text="{x:Bind Categories, Converter={StaticResource JoinStringsWithCommasConverter}}" />
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
