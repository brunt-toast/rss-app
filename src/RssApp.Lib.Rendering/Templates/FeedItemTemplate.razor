@using CodeHollow.FeedReader

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
</head>
<body>
    <h1>@Model.Title</h1>
    <p><strong>Link:</strong> <a href="@Model.Link">@Model.Link</a></p>
    <p><strong>Publish Date:</strong> @Model.PublishingDateString</p>
    <div>@Model.Description</div>
</body>
</html>

@code {
    [Parameter] public FeedItem Model { get; set; } = null!;
}
